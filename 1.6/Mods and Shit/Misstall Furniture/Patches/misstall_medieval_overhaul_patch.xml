						</match>
					</nomatch>
				</li>
				<li Class="PatchOperationConditional">
					<success>Always</success>
					<xpath>/Defs/ThingDef[defName = "DankPyon_RusticThickRoomDivider_Open1x2c"]/comps/li[@Class = "CompProperties_Styleable"]</xpath>
