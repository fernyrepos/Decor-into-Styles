								<comps>
									<li Class="CompProperties_Styleable" />
								</comps>
							</value>
						</nomatch>
						<match Class="PatchOperationAdd">
							<success>Always</success>
							<xpath>/Defs/ThingDef[defName = "DankPyon_RusticThickRoomDivider_Closed1x2c"]/comps</xpath>
							<value>
								<li Class="CompProperties_Styleable" />
