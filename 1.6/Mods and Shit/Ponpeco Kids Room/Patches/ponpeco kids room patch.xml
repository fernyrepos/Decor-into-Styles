					<success>Always</success>
					<xpath>/Defs/StyleCategoryDef[defName = "Ferny_Baby"]/thingDefStyles</xpath>
					<match Class="PatchOperationAdd">
						<success>Always</success>
						<xpath>/Defs/StyleCategoryDef[defName = "Ferny_Baby"]/thingDefStyles</xpath>
						<value>
							<li>
								<thingDef>Table_1x1c</thingDef>
