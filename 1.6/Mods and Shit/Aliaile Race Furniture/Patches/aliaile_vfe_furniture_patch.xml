<?xml version="1.0" encoding="utf-8" ?>
<Patch>
	<Operation Class="PatchOperationFindMod">
		<mods>
			<li>VanillaExpanded.VFECore</li>
		</mods>
		<match Class="PatchOperationSequence">
			<operations>
				<li Class="PatchOperationAdd">
					<xpath>/Defs/StyleCategoryDef[defName = "Ferny_Aliaile"]/thingDefStyles</xpath>
					<value>
						<li>
							<thingDef>Table_1x1c</thingDef>
							<styleDef>FernyAliaile_ARSaF_TableF</styleDef>
						</li>
					</value>
				</li>
				<li Class="PatchOperationConditional">
					<success>Always</success>
					<xpath>/Defs/ThingDef[defName = "Table_1x1c"]/comps/li[@Class = "CompProperties_Styleable"]</xpath>
					<nomatch Class="PatchOperationConditional">
						<success>Always</success>
						<xpath>/Defs/ThingDef[defName = "Table_1x1c"]/comps</xpath>
						<nomatch Class="PatchOperationAdd">
							<success>Always</success>
							<xpath>/Defs/ThingDef[defName = "Table_1x1c"]</xpath>
							<value>
								<comps>
									<li Class="CompProperties_Styleable" />
								</comps>
							</value>
						</nomatch>
						<match Class="PatchOperationAdd">
							<success>Always</success>
							<xpath>/Defs/ThingDef[defName = "Table_1x1c"]/comps</xpath>
							<value>
								<li Class="CompProperties_Styleable" />
							</value>
						</match>
					</nomatch>
				</li>
			</operations>
		</match>
	</Operation>
</Patch>
